# REGBOT_EFFORT=medium        # low | medium | high | xhigh | max
# REGBOT_TOP_K=8              # excerpts sent to the model per question
# REGBOT_EMBED_MODEL=         # e.g. BAAI/bge-small-en-v1.5 (needs sentence-transformers)
